{
  "schemaVersion": 1,
  "templateName": "APES CIC Codex agents template",
  "templateVersion": "v0.1.0b",
  "status": "beta",
  "sourceRepository": "APESCIC/agents-template",
  "defaultBranch": "main",
  "managedFiles": [
    { "path": "AGENTS.md", "purpose": "Codex bootstrap instructions", "updatePolicy": "overwrite-managed" },
    { "path": ".agents/AGENTS.md", "purpose": "Canonical APES CIC agent guidance", "updatePolicy": "overwrite-managed" },
    { "path": ".agents/template-manifest.json", "purpose": "Template version and managed file manifest", "updatePolicy": "overwrite-managed" },
    { "path": ".agents/skills/apes-repo-start/SKILL.md", "purpose": "Repo start workflow skill", "updatePolicy": "overwrite-managed" },
    { "path": ".agents/skills/apes-codex-plan/SKILL.md", "purpose": "APES planning workflow skill", "updatePolicy": "overwrite-managed" },
    { "path": ".agents/skills/apes-website-validation/SKILL.md", "purpose": "Website validation workflow skill", "updatePolicy": "overwrite-managed" },
    { "path": ".agents/skills/apes-github-handoff/SKILL.md", "purpose": "GitHub handoff workflow skill", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/CODEX_ENVIRONMENT_SETUP.md", "purpose": "Local execution and environment guidance", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/COMMIT_INSTRUCTIONS.md", "purpose": "Commit preparation guidance", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/PULL_AND_PULL_REQUEST_INSTRUCTIONS.md", "purpose": "Pull, push, and PR guidance", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/config.toml", "purpose": "Safe project-local Codex config", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/hooks/README.md", "purpose": "Inactive hook examples and rules", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/rules/README.md", "purpose": "Inactive command-rule examples and rules", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/scripts/discover-local-dev-tools.ps1", "purpose": "Read-only local tool inventory", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/scripts/validate-template.ps1", "purpose": "Template integrity validation", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/scripts/apply-agents-template.ps1", "purpose": "Dry-run-first template updater", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/laravel_architect.prompt.md", "purpose": "Laravel architecture prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/laravel_worker.prompt.md", "purpose": "Laravel implementation prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/auth_security_reviewer.prompt.md", "purpose": "Authentication and security prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/ui_designer.prompt.md", "purpose": "Laravel UI design prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/cloudron_deployment_reviewer.prompt.md", "purpose": "Cloudron deployment review prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/php_site_architect.prompt.md", "purpose": "HTML/PHP site architecture prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/php_worker.prompt.md", "purpose": "HTML/PHP implementation prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/frontend_ui_designer.prompt.md", "purpose": "Frontend UI prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/php_security_reviewer.prompt.md", "purpose": "PHP security prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/cloudron_lamp_reviewer.prompt.md", "purpose": "Cloudron LAMP prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/mysql_data_reviewer.prompt.md", "purpose": "MySQL data prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".codex/prompts/quality_reviewer.prompt.md", "purpose": "General quality prompt reference", "updatePolicy": "overwrite-managed" },
    { "path": ".github/pull_request_template.md", "purpose": "APES pull request template", "updatePolicy": "overwrite-managed" },
    { "path": ".github/ISSUE_TEMPLATE/codex_task.yml", "purpose": "Codex task issue template", "updatePolicy": "overwrite-managed" },
    { "path": ".github/ISSUE_TEMPLATE/bug_report.yml", "purpose": "Bug report issue template", "updatePolicy": "overwrite-managed" },
    { "path": ".github/ISSUE_TEMPLATE/feature_request.yml", "purpose": "Feature request issue template", "updatePolicy": "overwrite-managed" },
    { "path": ".github/ISSUE_TEMPLATE/config.yml", "purpose": "GitHub issue template chooser config", "updatePolicy": "overwrite-managed" },
    { "path": "docs/TEMPLATE_USAGE.md", "purpose": "Copying, updating, and adoption documentation", "updatePolicy": "overwrite-managed" },
    { "path": "README.md", "purpose": "Repository overview and quick start", "updatePolicy": "overwrite-managed" },
    { "path": "CHANGELOG.md", "purpose": "Template release record", "updatePolicy": "overwrite-managed" },
    { "path": "VERSION", "purpose": "Template version", "updatePolicy": "overwrite-managed" },
    { "path": ".gitattributes", "purpose": "Cross-platform text line ending rules", "updatePolicy": "overwrite-managed" },
    { "path": ".gitignore", "purpose": "Repository and downstream safety ignores", "updatePolicy": "overwrite-managed" }
  ],
  "copyRules": {
    "defaultMode": "dry-run",
    "applyRequiresSwitch": "-Apply",
    "refuseDirtyGitTargetByDefault": true,
    "allowDirtyTargetSwitch": "-AllowDirtyTarget",
    "createDirectories": true,
    "copyOnlyManagedFiles": true,
    "preserveTargetGitHistory": true
  },
  "protectedPaths": [
    ".git",
    ".env",
    ".env.local",
    ".env.*",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*.sqlite",
    "*.sqlite3",
    "*.dump",
    "*.bak",
    "*.backup",
    "local-dumps",
    "storage/logs",
    "var/log",
    "node_modules",
    "vendor",
    "public",
    "public/public",
    ".codex/local",
    ".codex/logs",
    ".codex/tmp",
    ".codex/cache",
    ".codex/attachments"
  ],
  "validation": {
    "requiredScript": ".codex/scripts/validate-template.ps1",
    "promptExtension": ".prompt.md",
    "activeHooksEnabledByDefault": false,
    "activeRulesEnabledByDefault": false
  }
}
